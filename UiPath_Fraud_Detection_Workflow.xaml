            <!-- Inject Chatbot Widget -->
            <ui:InjectJsScript DisplayName="Inject Chatbot Widget" sap:VirtualizedContainerService.HintSize="1164,51" sap2010:WorkflowViewState.IdRef="InjectJsScript_1" JsScript="// Chatbot injection script&#xA;console.log('🤖 Injecting UiPath Fraud Detection Chatbot...');&#xA;&#xA;// Create chatbot container&#xA;const chatbotContainer = document.createElement('div');&#xA;chatbotContainer.id = 'uipath-fraud-chatbot';&#xA;chatbotContainer.innerHTML = `&#xA;  &lt;div class=&quot;uipath-chatbot-trigger&quot; onclick=&quot;toggleUiPathChatbot()&quot;&gt;&#xA;    &lt;svg width=&quot;24&quot; height=&quot;24&quot; viewBox=&quot;0 0 24 24&quot; fill=&quot;white&quot;&gt;&#xA;      &lt;path d=&quot;M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z&quot;/&gt;&#xA;    &lt;/svg&gt;&#xA;    &lt;span class=&quot;uipath-indicator&quot;&gt;UiPath&lt;/span&gt;&#xA;  &lt;/div&gt;&#xA;  &lt;div class=&quot;uipath-chatbot-window&quot; id=&quot;uipath-chat-window&quot; style=&quot;display: none;&quot;&gt;&#xA;    &lt;div class=&quot;uipath-chat-header&quot;&gt;&#xA;      &lt;h4&gt;🤖 UiPath Fraud Assistant&lt;/h4&gt;&#xA;      &lt;button onclick=&quot;toggleUiPathChatbot()&quot;&gt;×&lt;/button&gt;&#xA;    &lt;/div&gt;&#xA;    &lt;div class=&quot;uipath-chat-messages&quot; id=&quot;uipath-messages&quot;&gt;&#xA;      &lt;div class=&quot;uipath-bot-message&quot;&gt;&#xA;        Hi! I'm your UiPath-powered fraud detection assistant. I can help you analyze transactions and navigate the system.&#xA;      &lt;/div&gt;&#xA;    &lt;/div&gt;&#xA;    &lt;div class=&quot;uipath-chat-input&quot;&gt;&#xA;      &lt;input type=&quot;text&quot; id=&quot;uipath-input&quot; placeholder=&quot;Ask me about fraud detection...&quot; onkeypress=&quot;handleUiPathEnter(event)&quot;&gt;&#xA;      &lt;button onclick=&quot;sendUiPathMessage()&quot;&gt;Send&lt;/button&gt;&#xA;    &lt;/div&gt;&#xA;  &lt;/div&gt;&#xA;`;&#xA;&#xA;// Add styles&#xA;const chatbotStyles = document.createElement('style');&#xA;chatbotStyles.textContent = `&#xA;  .uipath-chatbot-trigger {&#xA;    position: fixed;&#xA;    bottom: 30px;&#xA;    right: 30px;&#xA;    width: 60px;&#xA;    height: 60px;&#xA;    background: linear-gradient(135deg, #ff6b35, #f7931e);&#xA;    border-radius: 50%;&#xA;    display: flex;&#xA;    align-items: center;&#xA;    justify-content: center;&#xA;    cursor: pointer;&#xA;    box-shadow: 0 8px 25px rgba(255, 107, 53, 0.4);&#xA;    z-index: 10000;&#xA;    transition: all 0.3s ease;&#xA;  }&#xA;  .uipath-chatbot-trigger:hover {&#xA;    transform: scale(1.1);&#xA;  }&#xA;  .uipath-indicator {&#xA;    position: absolute;&#xA;    top: -8px;&#xA;    right: -8px;&#xA;    background: #00d4ff;&#xA;    color: white;&#xA;    font-size: 0.7rem;&#xA;    padding: 2px 6px;&#xA;    border-radius: 10px;&#xA;    font-weight: 600;&#xA;  }&#xA;  .uipath-chatbot-window {&#xA;    position: fixed;&#xA;    bottom: 100px;&#xA;    right: 30px;&#xA;    width: 350px;&#xA;    height: 500px;&#xA;    background: white;&#xA;    border-radius: 12px;&#xA;    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);&#xA;    z-index: 10001;&#xA;    display: flex;&#xA;    flex-direction: column;&#xA;    border: 2px solid #ff6b35;&#xA;  }&#xA;  .uipath-chat-header {&#xA;    background: linear-gradient(135deg, #ff6b35, #f7931e);&#xA;    color: white;&#xA;    padding: 1rem;&#xA;    border-radius: 10px 10px 0 0;&#xA;    display: flex;&#xA;    justify-content: space-between;&#xA;    align-items: center;&#xA;  }&#xA;  .uipath-chat-messages {&#xA;    flex: 1;&#xA;    padding: 1rem;&#xA;    overflow-y: auto;&#xA;  }&#xA;  .uipath-bot-message {&#xA;    background: #f0f0f0;&#xA;    padding: 0.75rem;&#xA;    border-radius: 8px;&#xA;    margin-bottom: 0.5rem;&#xA;  }&#xA;  .uipath-user-message {&#xA;    background: #ff6b35;&#xA;    color: white;&#xA;    padding: 0.75rem;&#xA;    border-radius: 8px;&#xA;    margin-bottom: 0.5rem;&#xA;    margin-left: 2rem;&#xA;  }&#xA;  .uipath-chat-input {&#xA;    display: flex;&#xA;    padding: 1rem;&#xA;    border-top: 1px solid #eee;&#xA;  }&#xA;  .uipath-chat-input input {&#xA;    flex: 1;&#xA;    padding: 0.5rem;&#xA;    border: 1px solid #ddd;&#xA;    border-radius: 6px 0 0 6px;&#xA;  }&#xA;  .uipath-chat-input button {&#xA;    padding: 0.5rem 1rem;&#xA;    background: #ff6b35;&#xA;    color: white;&#xA;    border: none;&#xA;    border-radius: 0 6px 6px 0;&#xA;    cursor: pointer;&#xA;  }&#xA;`;&#xA;&#xA;// Add to page&#xA;document.head.appendChild(chatbotStyles);&#xA;document.body.appendChild(chatbotContainer);&#xA;&#xA;// Chatbot functions&#xA;window.toggleUiPathChatbot = function() {&#xA;  const window = document.getElementById('uipath-chat-window');&#xA;  window.style.display = window.style.display === 'none' ? 'flex' : 'none';&#xA;};&#xA;&#xA;window.handleUiPathEnter = function(event) {&#xA;  if (event.key === 'Enter') {&#xA;    sendUiPathMessage();&#xA;  }&#xA;};&#xA;&#xA;window.sendUiPathMessage = function() {&#xA;  const input = document.getElementById('uipath-input');&#xA;  const messages = document.getElementById('uipath-messages');&#xA;  const message = input.value.trim();&#xA;  &#xA;  if (message) {&#xA;    // Add user message&#xA;    const userMsg = document.createElement('div');&#xA;    userMsg.className = 'uipath-user-message';&#xA;    userMsg.textContent = message;&#xA;    messages.appendChild(userMsg);&#xA;    &#xA;    // Clear input&#xA;    input.value = '';&#xA;    &#xA;    // Send to UiPath integration server&#xA;    fetch('http://localhost:8001/uipath/conversation', {&#xA;      method: 'POST',&#xA;      headers: { 'Content-Type': 'application/json' },&#xA;      body: JSON.stringify({&#xA;        user_message: message,&#xA;        bot_response: 'Processing...',&#xA;        timestamp: new Date().toISOString(),&#xA;        session_id: 'uipath_fraud_chat'&#xA;      })&#xA;    });&#xA;    &#xA;    // Add bot response (simulate)&#xA;    setTimeout(() => {&#xA;      const botMsg = document.createElement('div');&#xA;      botMsg.className = 'uipath-bot-message';&#xA;      botMsg.textContent = generateUiPathResponse(message);&#xA;      messages.appendChild(botMsg);&#xA;      messages.scrollTop = messages.scrollHeight;&#xA;    }, 1000);&#xA;  }&#xA;};&#xA;&#xA;window.generateUiPathResponse = function(message) {&#xA;  const lowerMsg = message.toLowerCase();&#xA;  &#xA;  if (lowerMsg.includes('analyze') || lowerMsg.includes('fraud')) {&#xA;    return '🔍 I can help you analyze transactions for fraud. Please provide the transaction amount and merchant name.';&#xA;  } else if (lowerMsg.includes('status') || lowerMsg.includes('health')) {&#xA;    return '✅ System is healthy! All fraud detection models are loaded and operational.';&#xA;  } else if (lowerMsg.includes('upload') || lowerMsg.includes('file')) {&#xA;    return '📁 To upload transaction files, navigate to the Real-Time Monitoring page and use the drag &amp; drop area.';&#xA;  } else {&#xA;    return '🤖 I'm your UiPath-powered fraud assistant. I can help with transaction analysis, system status, and navigation. What would you like to know?';&#xA;  }&#xA;};&#xA;&#xA;console.log('✅ UiPath Fraud Detection Chatbot injected successfully!');" />
            
